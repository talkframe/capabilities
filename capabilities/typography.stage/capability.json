{
  "id": "typography.stage",
  "version": 1,
  "tier": "builtin",
  "name": "文字舞台",
  "summary": "用项目级 poetry 或 science 预设呈现以文字为主体的分镜。",
  "when": {
    "use": [
      "全片以文字节奏和排版为主要画面",
      "项目已统一选择 poetry 或 science 预设"
    ],
    "avoid": [
      "单幕需要独立切换诗词与科学预设",
      "需要图片、节点、指标或语义关系图"
    ],
    "roles": [
      "intro",
      "keypoints",
      "flow",
      "chart",
      "comparison",
      "outro"
    ]
  },
  "inputs": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "assets": [],
  "constraints": {
    "aspect": [
      "16:9",
      "9:16"
    ],
    "minSeconds": 4,
    "maxSeconds": 40,
    "languages": [
      "zh",
      "en"
    ]
  },
  "timing": {
    "enter": "文字按项目预设进入",
    "hold": "随旁白保持并强调当前内容",
    "exit": "按项目预设退场"
  },
