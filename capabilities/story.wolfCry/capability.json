{
  "id": "story.wolfCry",
  "version": 1,
  "tier": "builtin",
  "name": "狼来了 · 诚实与信任",
  "summary": "L1 纯几何寓言：两次谎报消耗信任，真正求助时无人赶来。",
  "when": {
    "use": [
      "用抽象几何讲述狼来了的完整故事",
      "比较两次谎报与真正求助"
    ],
    "avoid": [
      "写实动物动作",
      "血腥捕食",
      "任意故事的自动角色导演"
    ],
    "roles": [
      "flow",
      "outro"
    ]
  },
  "inputs": {
    "type": "object",
    "properties": {
      "beat": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "description": "0 开场；1 首次谎报；2 再次谎报；3 真狼；4 无人赶来；5 寓意"
      },
      "sheepCount": {
        "type": "integer",
        "minimum": 4,
        "maximum": 8
      },
      "villagerCount": {
        "type": "integer",
        "minimum": 3,
        "maximum": 6
      }
    },
    "required": [
      "beat",
      "sheepCount",
      "villagerCount"
    ],
    "additionalProperties": false
  },
  "assets": [],
  "constraints": {
    "aspect": [
      "16:9"
    ],
    "minSeconds": 10,
    "maxSeconds": 60,
    "languages": [
      "zh"
    ]
  },
  "timing": {
    "enter": "cue-1 开始；每幕必须提供 cue-1/cue-2/cue-3 三个句子锚点",
    "hold": "动作随句级配音起点；cue-2 到 cue-3 至少 3.2 秒，尾句后保留至少 2.2 秒动作时间",
    "exit": "逐幕硬切，无外部素材"
  },
